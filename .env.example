# ── Supabase (public reads + server-side admin writes) ──
# Run supabase/*.sql files in SQL Editor (news.sql first, then child tables, then storage.sql)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Server only (never commit real values; never expose to the client) ──
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# ADMIN_SESSION_SECRET=optional-random-string-for-cookie-signing

# ── Scripts only ──
# SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# DATABASE_URL=
# SUPABASE_ADMIN_EMAIL=admin@example.com
# SUPABASE_ADMIN_PASSWORD=

# ── Local dev only (when Supabase vars are empty) ──
# Admin login falls back to admin / oepl-admin if ADMIN_USERNAME/PASSWORD are unset.
# Do NOT use NEXT_PUBLIC_ADMIN_* in production — they are bundled into the client.
# NEXT_PUBLIC_ADMIN_USERNAME=admin
# NEXT_PUBLIC_ADMIN_PASSWORD=oepl-admin
