# ── Supabase ──
# Run supabase/*.sql in the SQL Editor, in this order:
#   admins.sql  (defines public.is_admin(), which every other policy depends on)
#   news.sql → the other table files → storage.sql
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Admin access ──
# There is no admin password in this file. Admins are Supabase Auth accounts listed
# in public.admin_users; see the instructions at the bottom of supabase/admins.sql.
# Create the account in Authentication → Users, then insert its id into that table.
#
# Also turn OFF public signups (Authentication → Providers → Email → "Enable signups")
# unless you want anyone to be able to create an account. They still couldn't write
# anything without being in admin_users, but there's no reason to allow it.

# ── Scripts only (never used by the running app) ──
# Seeding bypasses RLS, so keep this out of the app's environment and out of git.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# DATABASE_URL=
# SUPABASE_ADMIN_EMAIL=admin@example.com
# SUPABASE_ADMIN_PASSWORD=
